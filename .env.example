# Copy to .env.local and adjust. Never commit real secrets.

# --- Database -------------------------------------------------------------
# docker compose up -d   ->  postgres://ph_sms:ph_sms_dev@127.0.0.1:5432/ph_sms
# npm run db:dev         ->  postgres://ph_sms:ph_sms_dev@127.0.0.1:54329/ph_sms
DATABASE_URL=postgres://ph_sms:ph_sms_dev@127.0.0.1:54329/ph_sms
TEST_DATABASE_URL=postgres://ph_sms:ph_sms_dev@127.0.0.1:54329/ph_sms_test
# Hosted only: a direct (non-pooled) connection for migrations when DATABASE_URL
# goes through a pooler. Neon's Vercel integration sets it.
# DATABASE_URL_UNPOOLED=

# --- Runtime mode ---------------------------------------------------------
# MOCK | PARTNER_SANDBOX | LIVE. Server-controlled; MOCK is the default.
# LIVE additionally requires approved pricing/policy configuration to be present.
APP_MODE=MOCK

# --- Secrets --------------------------------------------------------------
# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Used for suppression-hash keying and signed opt-out tokens. Rotate via *_PREVIOUS.
SUPPRESSION_HMAC_KEY=
SUPPRESSION_HMAC_KEY_VERSION=1
# Set only during a key rotation. See docs/RUNBOOK.md — rotating without these
# would silently stop stored opt-outs matching.
SUPPRESSION_HMAC_KEY_PREVIOUS=
SUPPRESSION_HMAC_KEY_PREVIOUS_VERSION=
# Encrypts stored CSV originals and recipient snapshots at rest.
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_PREVIOUS=

# --- Partner SMS provider (LIVE / PARTNER_SANDBOX only) -------------------
# Left empty on purpose: the partner contract is not available yet and the
# adapter fails explicitly rather than guessing a payload shape.
PARTNER_SMS_BASE_URL=
PARTNER_SMS_API_KEY=
PARTNER_SMS_WEBHOOK_SECRET=

# --- Payment provider (LIVE only) ----------------------------------------
PAYMENT_PROVIDER=MOCK
PAYMENT_WEBHOOK_SECRET=
PAYMENT_MERCHANT_ID=

# --- Mail -----------------------------------------------------------------
# In MOCK mode mail is written to the database sink and shown at /dev/mail.
MAIL_TRANSPORT=SINK
# Required when MAIL_TRANSPORT=SMTP. Needs `npm install nodemailer`.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Absolute base used for links in outgoing mail.
APP_BASE_URL=http://localhost:3000

# --- Scheduled jobs (hosted) ----------------------------------------------
# Bearer secret for /api/cron/dispatch and /api/cron/retention. Unset, they
# refuse every call. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
# Dispatch due jobs from the web process after a send responds and after
# signed-in page views, for hosts with no worker process. Unset = on under
# Vercel, off elsewhere. See docs/DEPLOYMENT.md.
DISPATCH_AFTER_RESPONSE=
