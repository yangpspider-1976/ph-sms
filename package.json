  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "vercel-build": "node scripts/vercel-build.mjs",
    "worker": "node --conditions=react-server --import tsx src/server/jobs/worker.ts",
    "db:dev": "node scripts/dev-db.mjs start",
    "db:reset": "node scripts/dev-db.mjs reset",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --conditions=react-server --import tsx src/server/db/migrate.ts",
    "seed": "node --conditions=react-server --import tsx src/server/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "retention": "node --conditions=react-server --import tsx src/server/jobs/run-retention.ts",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "rotate-keys": "node --conditions=react-server --import tsx src/server/jobs/rotate-keys.ts",
    "rehearse-restore": "node --conditions=react-server --import tsx src/server/jobs/restore-rehearsal.ts",
    "export-suppressions": "node --conditions=react-server --import tsx src/server/jobs/suppression-journal.ts",
    "import-suppressions": "node --conditions=react-server --import tsx src/server/jobs/suppression-journal-import.ts",
    "benchmark": "node --conditions=react-server --import tsx src/server/jobs/benchmark.ts"
  },
  "keywords": [],
